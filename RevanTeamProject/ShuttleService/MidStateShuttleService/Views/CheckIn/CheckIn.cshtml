                @model MidStateShuttleService.Models.CheckIn

<link rel="stylesheet" href="/css/CheckIn.css" />
<link rel="stylesheet" href="/css/Modal.css" />

<!-- Include jQuery and Bootstrap JS -->
<script src="https://code.jquery.com/jquery-3.3.1.slim.min.js"></script>
<script src="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/js/bootstrap.min.js"></script>
<link rel="stylesheet" href="/css/Form.css" />
<link rel="stylesheet" href="/css/Input.css" />
<link rel="stylesheet" href="/css/HelpIcon.css" />


<body>
    <div class="form-container tiled-background-1">
        <div class="form-paper">

            <section class="form-section">
                <h2>Shuttle Check-In</h2>

                <form asp-controller="CheckIn"
                      asp-action="CheckIn"
                      method="post">

                    <!-- Student ID -->
                    <div class="form-group">
                        <label asp-for="StudentId"></label>
                        <input asp-for="StudentId"
                               class="form-control midstate-textinput"
                               placeholder="Enter your Student ID" />
                    </div>

                    <!-- Name -->
                    <div class="form-group">
                        <label asp-for="Name"></label>
                        <input asp-for="Name"
                               class="form-control midstate-textinput"
                               placeholder="Enter your name"
                               required />
                    </div>

                    <!-- Locations Row -->
                    <div class="form-row">
                        <div class="form-group col-md-6">
                            <label asp-for="LocationId">Pick-Up Location</label>
                            <select asp-for="LocationId"
                                    asp-items="ViewBag.Locations"
                                    class="dropdown-midstate"
                                    required>
                                <option value="">-- Select --</option>
                            </select>
                        </div>

                        <div class="form-group col-md-6">
                            <label asp-for="DropOffLocationId">Drop-Off Location</label>
                            <select asp-for="DropOffLocationId"
                                    asp-items="ViewBag.Locations"
                                    class="dropdown-midstate"
                                    required>
                                <option value="">-- Select --</option>
                            </select>
                        </div>
                    </div>

                    <!-- First Time Rider -->
                    <div class="form-group">
                        <p>Is this your first time riding?</p>

                        <div class="radiobtn-midstate">
                            <input asp-for="FirstTime"
                                   type="radio"
                                   value="true"
                                   id="newRiderYes"
                                   required />
                            <label for="newRiderYes">Yes</label>
                        </div>

                        <div class="radiobtn-midstate">
                            <input asp-for="FirstTime"
                                   type="radio"
                                   value="false"
                                   id="newRiderNo"
                                   required />
                            <label for="newRiderNo">No</label>
                        </div>
                    </div>

                    <!-- Comments -->
                    <div class="form-group">
                        <label asp-for="Comments">Rider Comments / Suggestions</label>
                        <textarea asp-for="Comments"
                                  class="form-control midstate-textinput"
                                  rows="4"
                                  maxlength="255"
                                  placeholder="Share your experience"></textarea>
                    </div>

                    <!-- Buttons -->
                    <div class="form-group submit-group">
                        <button type="submit"
                                class="btn-midstate btn-primary">
                            Check-In
                        </button>

                        <button type="button"
                                class="btn-midstate btn-secondary"
                                onclick="history.go(-1)">
                            Cancel
                        </button>
                    </div>

                </form>
            </section>

        </div>
    </div>

    <script src="/js/CheckIn.js"></script>
</body>

<!-- Success Modal -->
<div class="modal fade" id="successModal" tabindex="-1" role="dialog" aria-labelledby="successModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="successModalLabel">Check-in</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                Check-in Successful!
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    $(document).ready(function () {
        var checkInSuccess = '@TempData["CheckInSuccess"]';
        if (checkInSuccess === 'True') {
            $('#successModal').modal('show');
        }
    });
</script>