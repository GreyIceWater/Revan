@model MidStateShuttleService.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@await Html.PartialAsync("~/Views/Shared/_DashboardNav.cshtml")

<body>
    <div class="dashboard-landing tiled-background-2">
        <!-- Key Metrics -->
        <section class="dashboard-stats-container mb-5">

            <a asp-controller="Register" asp-action="ViewAll" class="text-decoration-none">
                <div class="dashboard-stat-card bg-primary text-white shadow-sm">
                    <div class="card-body text-center">
                        <i class="bi bi-calendar-week fs-1 mb-2"></i>
                        <h3 class="display-5">@Model.PastWeekRegistrations</h3>
                        <p class="mb-0">Weekly Requests</p>
                    </div>
                </div>
            </a>

            <a asp-controller="CheckIn" asp-action="ViewAll" class="text-decoration-none">
                <div class="dashboard-stat-card bg-success text-white shadow-sm">
                    <div class="card-body text-center">
                        <i class="bi bi-clipboard2-check fs-1 mb-2"></i>
                        <h3 class="display-5">@Model.TotalMonthlyCheckins</h3>
                        <p class="mb-0">Monthly Check-ins</p>
                    </div>
                </div>
            </a>

            <div class="dashboard-stat-card bg-warning text-white shadow-sm">
                <div class="card-body text-center">
                    <i class="bi bi-envelope fs-1 mb-2"></i>
                    <h3 class="display-5">0</h3>
                    <p class="mb-0">Mail Check Ins</p>
                </div>
            </div>

            <a asp-controller="Register" asp-action="ViewAll" class="text-decoration-none">
                <div class="dashboard-stat-card bg-danger text-white shadow-sm">
                    <div class="card-body text-center">
                        <i class="bi bi-clipboard-data fs-1 mb-2"></i>
                        <h3 class="display-5">@Model.TotalRequests</h3>
                        <p class="mb-0">Total Requests</p>
                    </div>
                </div>
            </a>

        </section>

        <!-- NOTIFICATIOSN -->
        <section class="dashboard-notifications mb-5">

            <div class="card shadow-sm">

                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">
                        <i class="bi bi-chat-left-text me-2"></i>
                        Recent Notifications
                    </h5>

                    <span class="badge bg-danger"
                          data-message-count="@ViewData["MessageCount"]"
                          data-feedback-count="@ViewData["FeedbackCount"]">
                    </span>
                </div>

                <ul class="list-group list-group-flush"
                    id="notificationMessageDropdown"
                    data-message-count="@ViewData["MessageCount"]"
                    data-feedback-count="@ViewData["FeedbackCount"]"
                    data-last-message="@ViewData["LastMessage"]"
                    data-last-feedback="@ViewData["LastFeedback"]">
                </ul>

            </div>

        </section>

        <!-- start message table -->
        @if (User.IsInRole("Admin"))
        {
            <div class="form-container tiled-background-2">
                <div class="form-paper">

                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div>
                            <h2>Messages</h2>
                            <p class="mb-0">View and manage user messages.</p>
                        </div>
                    </div>

                    <div id="messageTableBody">

                        @if (Model.Messages == null || !Model.Messages.Any())
                        {
                            <div class="form-paper p-3">
                                <p>There are currently no messages.</p>
                            </div>
                        }
                        else
                        {
                            @foreach (var message in Model.Messages.OrderByDescending(m => m.id))
                            {
                                if (message.IsActive)
                                {
                                    <div class="form-paper mb-4 p-4 position-relative message-card">

                                        <div class="d-flex justify-content-between align-items-start">

                                            <div>

                                                <h4 class="mb-2">@message.name</h4>

                                                <div class="mb-2">
                                                    <strong>Message:</strong>
                                                    @message.message
                                                    
                                                </div>

                                                <div>
                                                    <span>
                                                        <strong>Response Required:</strong>
                                                        @(message.responseRequired ? "Yes" : "No")
                                                    </span>

                                                    <span> | </span>

                                                    <span>
                                                        <strong>Contact:</strong>
                                                        @(string.IsNullOrEmpty(message.contactInfo) ? "N/A" : message.contactInfo)
                                                    </span>
                                                </div>

                                            </div>

                                            <div class="text-end">

                                                <a asp-controller="Communicate"
                                                   asp-action="Delete"
                                                   asp-route-id="@message.id"
                                                   class="btn btn-midstate btn-danger btn-sm">
                                                    <i class="bi bi-check-circle-fill me-1"></i> Mark as Read
                                                </a>

                                            </div>

                                        </div>

                                    </div>
                                }
                            }
                        }

                    </div>

                    <div id="pagination-controls-message" class="pagination"></div>

                </div>
            </div>
            <!-- end message table -->
        }
        
    </div>
</body>

<script src="~/js/tablePagination.js"></script>
<script src="~/js/Dashboard/MessageModal.js"></script>


<style>
    .message-card {
        word-wrap: break-word;
        overflow-wrap: break-word;
        word-break: break-word;
    }

    .dashboard-stat-card {
        border-radius: 12px;
        padding: 15px;
        transition: transform 0.2s;
    }

        /* Make all stat cards maroon */
        .dashboard-stat-card.bg-primary,
        .dashboard-stat-card.bg-success,
        .dashboard-stat-card.bg-warning,
        .dashboard-stat-card.bg-danger {
            background-color: #800000 !important; /* maroon */
            color: white !important;
        }

        /* Icons white */
        .dashboard-stat-card i {
            color: white;
        }

        /* Hover effect */
        .dashboard-stat-card:hover {
            transform: translateY(-5px);
            background-color: #a00000 !important; /* lighter maroon */
        }

    .dashboard-landing {
        margin-left: 300px;
        padding: 40px 20px;
        min-height: 100vh;
    }

    .dashboard-header h1 {
        font-weight: 700;
        color: #800000; /* Maroon heading */
    }

    .dashboard-stats-container {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 30px;
    }

    .dashboard-stat-card {
        width: 220px;
        border-radius: 12px;
        padding: 15px;
        transition: transform 0.2s;
        color: white;
        background-color: #800000; /* Maroon background */
    }

        .dashboard-stat-card:hover {
            transform: translateY(-5px);
            background-color: #a00000; /* Slightly lighter maroon on hover */
        }

    .dashboard-quick-access {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 20px;
    }

    .quick-access-card {
        width: 220px;
    }

        .quick-access-card .card {
            border-radius: 12px;
            padding: 20px;
            transition: transform 0.2s, box-shadow 0.2s;
            background-color: #800000; /* Maroon card */
            color: white;
        }

            .quick-access-card .card:hover {
                transform: translateY(-5px);
                box-shadow: 0 8px 20px rgba(128, 0, 0, 0.4); /* Maroonish shadow */
                background-color: #a00000; /* Slightly lighter maroon hover */
            }

        .quick-access-card i {
            color: #ffc107; /* Use gold/yellow for icons to contrast maroon */
        }

    .dashboard-header-container {
        display: flex;
        justify-content: center;
    }

    .dashboard-header-card {
        background-color: #800000; /* Maroon background */
        border-radius: 20px; /* Rounded corners */
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.2); /* Subtle shadow */
        max-width: 800px;
        width: 100%;
        padding: 40px 30px;
        color: white;
        transition: transform 0.2s, box-shadow 0.2s;
    }

        .dashboard-header-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 12px 30px rgba(0, 0, 0, 0.25);
        }

        .dashboard-header-card h1 {
            font-weight: 700;
        }

        .dashboard-header-card p {
            margin-top: 10px;
            font-size: 1.2rem;
        }

    @@media (max-width: 768px) {
        .dashboard-landing {
            margin-left: 0;
            padding: 40px 20px;
            min-height: 100vh;
        }

        .dashboard-stats-container,
        .dashboard-quick-access {
            flex-direction: column;
            align-items: center;
        }
    }
</style>

<script src="/js/Dashboard/DisplayNotification.js"></script>
<script src="/js/Dashboard/notification.js"></script>