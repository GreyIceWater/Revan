@model MidStateShuttleService.Models.AllModels
@using System.Linq
@using MidStateShuttleService.Models

@{
    ViewData["Title"] = "Reports";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    // DEV NOTE:
    // Controller sets ViewBag.ReportType ("requests" or "checkins")
    // This determines which report section renders below.
    var reportType = (ViewBag.ReportType as string) ?? "";

    var isRequests = reportType.Equals("requests", StringComparison.OrdinalIgnoreCase);
    var isCheckins = reportType.Equals("checkins", StringComparison.OrdinalIgnoreCase);

    // DEV NOTE:
    // Convert model collections to lists so we can safely use Count(), Any(), and foreach.
    // Also prevents null reference errors if the controller didn't populate them.
    var requestRows = (Model.Register ?? Enumerable.Empty<RegisterModel>()).ToList();
    var checkinRows = (Model.CheckIn ?? Enumerable.Empty<CheckIn>()).ToList();
}

<!-- DEV NOTE: Page styling -->
<link rel="stylesheet" href="~/css/Dashboard.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/Reports..css" asp-append-version="true" />

<div class="reportsPage">

    <!-- DEV NOTE: PAGE HEADER -->
    <div class="reportsPageTopBar">
        <div class="reportsHeaderLeft">
            <h2 class="reportsTitle">Reports</h2>
            <div class="reportsHint">Run admin reports and export CSV files.</div>
        </div>

        <!-- DEV NOTE: Returns user to the dashboard reports widget -->
        <a class="rptBtn rptBtnGhost"
           href="@Url.Action("Index", "Dashboard", new { section = "reports" })">
            ← Back to Dashboard
        </a>
    </div>

    <!-- DEV NOTE: REPORT PICKER -->
    <!-- User selects which report to run -->
    <div class="reportCard">
        <div class="reportCardHeader">
            <div class="reportCardHeaderText">
                <div class="reportCardHeaderTitle">Report Picker</div>
                <div class="reportCardHeaderSub">Choose a report type to view results.</div>
            </div>
        </div>

        <div class="reportCardBody">
            <div class="reportPickerGrid">

                <!-- DEV NOTE: Rider Requests report option -->
                <div class="reportOption @(isRequests ? "reportOptionActive" : "")">
                    <div class="reportOptionTop">
                        <div class="reportOptionText">
                            <p class="reportOptionTitle">Rider Requests</p>
                            <p class="reportOptionDesc">All registrations (newest first)</p>
                        </div>

                        <div class="reportOptionMeta">
                            <span class="pill pill-neutral">All time</span>
                        </div>
                    </div>

                    <div class="reportOptionActions">

                        <!-- DEV NOTE: Loads the Rider Requests report -->
                        <a class="rptBtn"
                           href="@Url.Action("Reports", "Dashboard", new { report = "requests" })">
                            Run
                        </a>

                        <!-- DEV NOTE: CSV export of rider request data -->
                        <a class="rptBtn rptBtnOutline"
                           href="@Url.Action("ExportRiderRequestsCsv", "Dashboard")">
                            Export CSV
                        </a>
                    </div>
                </div>

                <!-- DEV NOTE: Check-ins report option -->
                <div class="reportOption @(isCheckins ? "reportOptionActive" : "")">
                    <div class="reportOptionTop">
                        <div class="reportOptionText">
                            <p class="reportOptionTitle">Check-ins</p>
                            <p class="reportOptionDesc">All check-ins (newest first)</p>
                        </div>

                        <div class="reportOptionMeta">
                            <span class="pill pill-neutral">All time</span>
                        </div>
                    </div>

                    <div class="reportOptionActions">

                        <!-- DEV NOTE: Loads the Check-ins report -->
                        <a class="rptBtn"
                           href="@Url.Action("Reports", "Dashboard", new { report = "checkins" })">
                            Run
                        </a>

                        <!-- DEV NOTE: CSV export for check-in data -->
                        <a class="rptBtn rptBtnOutline"
                           href="@Url.Action("ExportCheckInsCsv", "Dashboard")">
                            Export CSV
                        </a>
                    </div>
                </div>

            </div>
        </div>
    </div>

    @* DEV NOTE:
       Razor rule reminder:
       No markup between @if and else if blocks *@

    @if (isRequests)
    {
        <!-- DEV NOTE: Rider Requests report table -->
        <div class="reportCard reportResultsBlock">
            <div class="reportStickyBar">
                <div class="reportStickyLeft">
                    <h3>Rider Requests</h3>
                    <span class="reportSubtitle">All time</span>
                </div>

                <div class="reportStickyRight">

                    <!-- Back to report picker -->
                    <a class="rptBtn rptBtnGhost"
                       href="@Url.Action("Index", "Dashboard", new { section = "reports" })">
                        ← Back
                    </a>

                    <!-- Row count indicator -->
                    <span class="pill pill-neutral">Rows: @requestRows.Count</span>

                    <!-- Export same data shown in table -->
                    <a class="rptBtn rptBtnOutline"
                       href="@Url.Action("ExportRiderRequestsCsv", "Dashboard")">
                        Export CSV
                    </a>
                </div>
            </div>

            <!-- DEV NOTE: Scrollable results table -->
            <div class="reportScrollArea">
                <table class="reportsTable">
                    <thead>
                        <tr>
                            <th>RegistrationId</th>
                            <th>Name</th>
                            <th>StudentId</th>
                            <th>Email</th>
                            <th>Phone</th>
                            <th>Over 18</th>
                            <th>Request Type</th>
                            <th>Field Trip</th>
                            <th>Internal Inquiry</th>
                            <th>Created</th>
                            <th>Archived</th>
                        </tr>
                    </thead>

                    <tbody>

                        <!-- DEV NOTE: Empty state -->
                        @if (!requestRows.Any())
                        {
                            <tr>
                                <td colspan="11" class="emptyCell">No rider request records found.</td>
                            </tr>
                        }
                        else
                        {
                            // DEV NOTE: Loop through each registration record
                            foreach (var r in requestRows)
                            {
                                <tr>
                                    <td>@r.RegistrationId</td>
                                    <td>@r.Name</td>
                                    <td>@r.StudentId</td>
                                    <td>@r.Email</td>
                                    <td>@r.Phone</td>

                                    <td>
                                        <span class="pill @(r.IsAdult ? "pill-yes" : "pill-no")">
                                            @(r.IsAdult ? "Yes" : "No")
                                        </span>
                                    </td>

                                    <td>
                                        <span class="pill @(r.isCustom ? "pill-yes" : "pill-no")">
                                            @(r.isCustom ? "Special" : "Regular")
                                        </span>
                                    </td>

                                    <td>
                                        <span class="pill @(r.IsFieldTrip ? "pill-yes" : "pill-no")">
                                            @(r.IsFieldTrip ? "Yes" : "No")
                                        </span>
                                    </td>

                                    <td>
                                        <span class="pill @(r.IsInternalInquiry ? "pill-yes" : "pill-no")">
                                            @(r.IsInternalInquiry ? "Yes" : "No")
                                        </span>
                                    </td>

                                    <td>@(r.InsertDateTime?.ToString("g") ?? "")</td>

                                    <td>
                                        <span class="pill @(r.IsArchived ? "pill-no" : "pill-yes")">
                                            @(r.IsArchived ? "Yes" : "No")
                                        </span>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else if (isCheckins)
    {
        <!-- DEV NOTE: Check-ins report table -->
        <div class="reportCard reportResultsBlock">
            <div class="reportStickyBar">
                <div class="reportStickyLeft">
                    <h3>Check-ins</h3>
                    <span class="reportSubtitle">All time</span>
                </div>

                <div class="reportStickyRight">
                    <a class="rptBtn rptBtnGhost"
                       href="@Url.Action("Index", "Dashboard", new { section = "reports" })">
                        ← Back
                    </a>

                    <span class="pill pill-neutral">Rows: @checkinRows.Count</span>

                    <a class="rptBtn rptBtnOutline"
                       href="@Url.Action("ExportCheckInsCsv", "Dashboard")">
                        Export CSV
                    </a>
                </div>
            </div>

            <div class="reportScrollArea">
                <table class="reportsTable">
                    <thead>
                        <tr>
                            <th>CheckInId</th>
                            <th>Name</th>
                            <th>StudentId</th>
                            <th>Date</th>
                            <th>First Time</th>
                            <th>Pick Up</th>
                            <th>Drop Off</th>
                            <th>Comments</th>
                        </tr>
                    </thead>

                    <tbody>

                        <!-- DEV NOTE: Empty state -->
                        @if (!checkinRows.Any())
                        {
                            <tr>
                                <td colspan="8" class="emptyCell">No check-in records found.</td>
                            </tr>
                        }
                        else
                        {
                            // DEV NOTE: Loop through check-in records
                            foreach (var c in checkinRows)
                            {
                                <tr>
                                    <td>@c.CheckInId</td>
                                    <td>@c.Name</td>
                                    <td>@c.StudentId</td>
                                    <td>@c.Date.ToString("g")</td>

                                    <td>
                                        <span class="pill @(c.FirstTime ? "pill-yes" : "pill-no")">
                                            @(c.FirstTime ? "Yes" : "No")
                                        </span>
                                    </td>

                                    @* DEV NOTE: These depend on navigation properties being loaded in controller *@
                                    <td>@(c.Location?.Name ?? $"#{c.LocationId}")</td>
                                    <td>@(c.DropOffLocation?.Name ?? $"#{c.DropOffLocationId}")</td>

                                    <td class="truncate" title="@c.Comments">@c.Comments</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

</div>