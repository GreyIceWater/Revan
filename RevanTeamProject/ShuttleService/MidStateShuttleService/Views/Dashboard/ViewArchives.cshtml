@{
    ViewData["Title"] = "View Archives";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@await Html.PartialAsync("~/Views/Shared/_DashboardNav.cshtml")

<link rel="stylesheet" href="/css/DashBoardIndex.css" />
<link rel="stylesheet" href="/css/Form.css" />
<link rel="stylesheet" href="/css/Input.css" />

<style>
    .archive-card {
        min-width: 280px;
        padding: 2.5rem 2rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        transition: box-shadow 0.2s, transform 0.2s;
    }

        .archive-card:hover {
            box-shadow: 0 6px 20px rgba(0, 0, 0, 0.15);
            transform: translateY(-3px);
        }

    .archive-icon {
        color: #7a1f2b; /* maroon */
        font-size: 2.5rem;
        margin-bottom: 0.75rem;
    }

    .archive-card h5 {
        color: #7a1f2b;
        font-weight: 600;
    }
</style>

<body>
    <div class="dashboard-landing tiled-background-2">
        <div class="form-container tiled-background-2">
            <div class="form-paper">

                <div class="section-header">
                    <h2 class="mb-0">View Archives</h2>
                    <p class="text-muted mb-0">Browse archived records across all categories.</p>
                </div>

                <div class="row g-4">

                    <!-- Requests -->
                    <div class="col-12">
                        <div class="form-paper archive-card">
                            <i class="bi bi-file-earmark-text-fill archive-icon"></i>
                            <h5>Requests</h5>
                            <p>View all archived registration requests.</p>
                            <div class="archive-btn-wrapper">
                                <a asp-controller="Register" asp-action="ViewAll" asp-route-viewArchived="true"
                                   class="btn btn-midstate">
                                    <i class="bi bi-archive-fill me-1"></i> View Archived
                                </a>
                            </div>
                        </div>
                    </div>

                    <!-- Routes -->
                    <div class="col-12">
                        <div class="form-paper archive-card">
                            <i class="bi bi-signpost-split-fill archive-icon"></i>
                            <h5>Routes</h5>
                            <p>View all archived shuttle routes.</p>
                            <div class="archive-btn-wrapper">
                                <a asp-controller="Routes" asp-action="ViewAll" asp-route-viewArchived="true"
                                   class="btn btn-midstate">
                                    <i class="bi bi-archive-fill me-1"></i> View Archived
                                </a>
                            </div>
                        </div>
                    </div>

                    <!-- Shuttles -->
                    <div class="col-12">
                        <div class="form-paper archive-card">
                            <i class="bi bi-bus-front archive-icon"></i>
                            <h5>Shuttles</h5>
                            <p>View all archived shuttle vehicles.</p>
                            <div class="archive-btn-wrapper">
                                <a asp-controller="Shuttles" asp-action="ViewAll" asp-route-viewArchived="true"
                                   class="btn btn-midstate">
                                    <i class="bi bi-archive-fill me-1"></i> View Archived
                                </a>
                            </div>
                        </div>
                    </div>

                    <!-- Drivers -->
                    <div class="col-12">
                        <div class="form-paper archive-card">
                            <i class="bi bi-person-vcard-fill archive-icon"></i>
                            <h5>Drivers</h5>
                            <p>View all archived driver records.</p>
                            <div class="archive-btn-wrapper">
                                <a asp-controller="Driver" asp-action="ViewAll" asp-route-viewArchived="true"
                                   class="btn btn-midstate">
                                    <i class="bi bi-archive-fill me-1"></i> View Archived
                                </a>
                            </div>
                        </div>
                    </div>

                    <!-- Checkins -->
                    <div class="col-12">
                        <div class="form-paper archive-card">
                            <i class="bi bi-clipboard-check-fill archive-icon"></i>
                            <h5>Check Ins</h5>
                            <p>View all archived check-ins.</p>
                            <div class="archive-btn-wrapper">
                                <a asp-controller="CheckIn" asp-action="ViewAll" asp-route-viewArchived="true"
                                   class="btn btn-midstate">
                                    <i class="bi bi-archive-fill me-1"></i> View Archived
                                </a>
                            </div>
                        </div>
                    </div>

                    <!-- Locations -->
                    <div class="col-12">
                        <div class="form-paper archive-card">
                            <i class="bi bi-geo-alt-fill archive-icon"></i>
                            <h5>Locations</h5>
                            <p>View all archived locations.</p>
                            <div class="archive-btn-wrapper">
                                <a asp-controller="Location" asp-action="ViewAll" asp-route-viewArchived="true"
                                   class="btn btn-midstate">
                                    <i class="bi bi-archive-fill me-1"></i> View Archived
                                </a>
                            </div>
                        </div>
                    </div>

                    <!-- Messages -->
                    <div class="col-12">
                        <div class="form-paper archive-card">
                            <i class="bi bi-chat-dots-fill archive-icon"></i>
                            <h5>Messages</h5>
                            <p>View all archived messages.</p>
                            <div class="archive-btn-wrapper">
                                <a asp-controller="Communicate" asp-action="ViewAll" asp-route-viewArchived="true"
                                   class="btn btn-midstate">
                                    <i class="bi bi-archive-fill me-1"></i> View Archived
                                </a>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</body>