@model IEnumerable<MidStateShuttleService.Models.Feedback>

@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}


@await Html.PartialAsync("~/Views/Shared/_DashboardNav.cshtml")

<div class="form-container tiled-background-2">
    <div class="form-paper">

        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h2>Testimonials</h2>
                <p class="mb-0">Manage customer feedback.</p>
            </div>
        </div>

        <div id="feedbackTableBody">

            @if (Model == null || !Model.Any())
            {
                <div class="form-paper p-3">
                    <p>No testimonials currently exist.</p>
                </div>
            }
            else
            {
                @foreach (var f in Model.OrderByDescending(f => f.FeedbackId))
                {
                    <div class="form-paper mb-4 p-4 position-relative feedback-card">

                        <div class="d-flex justify-content-between align-items-start">

                            <div>
                                <h4 class="mb-1">@f.CustomerName</h4>

                                <div class="mb-1 comment-text">
                                    <strong>Comment:</strong>
                                    @f.Comment
                                </div>

                                <div>
                                    <span><strong>Rating:</strong> @f.Rating</span>
                                    <span> | </span>
                                    <span><strong>Share Testimonial:</strong> @(f.DisplayTestimonial ? "Yes" : "No")</span>
                                    <span> | </span>
                                    <span><strong>Date Submitted:</strong> @f.DateSubmitted.ToString("MM-dd-yyyy")</span>
                                    <span> | </span>
                                    <span><strong>Status:</strong> @(f.IsActive ? "Active" : "Inactive")</span>
                                </div>
                            </div>

                            <div class="text-end">

                                <form asp-controller="Feedback"
                                      asp-action="ArchiveFeedback"
                                      asp-route-id="@f.FeedbackId"
                                      method="post"
                                      class="d-inline">

                                    <button type="submit" class="btn btn-midstate btn-sm me-1">
                                        <i class="bi bi-check-circle-fill me-1"></i> Archive
                                    </button>

                                </form>

                            </div>

                        </div>

                    </div>
                }
            }

        </div>

        <div id="pagination-controls-feedback" class="pagination"></div>

    </div>
</div>

<!-- Feedback Details Modal (unchanged) -->
<div class="modal fade" id="feedbackDetailsModal" tabindex="-1" role="dialog" aria-labelledby="feedbackDetailsModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="feedbackDetailsModalLabel">Testimonial Details</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div id="feedbackDetailsContent"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<style>
    .comment-text {
        overflow-wrap: break-word;
        word-break: break-word;
    }
</style>

<script src="~/js/tablePagination.js"></script>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="/js/Dashboard/FeedbackModal.js"></script>
<script src="/js/Dashboard/feedbackManagement.js"></script>