@using MidStateShuttleService.Enums
@model MidStateShuttleService.Models.RegisterModel

@{
    ViewBag.Title = "Edit Registration";
}

<link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/css/bootstrap.min.css">
<link rel="stylesheet" href="/css/Form.css" />
<link rel="stylesheet" href="/css/Input.css" />
<link rel="stylesheet" href="/css/HelpIcon.css" />

<script src="https://code.jquery.com/jquery-3.3.1.slim.min.js"></script>
<script src="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/js/bootstrap.min.js"></script>

<div class="form-container tiled-background-1">
    <div class="form-paper">

        <h2>Edit Registration</h2>

        @using (Html.BeginForm("EditSave", "Register", FormMethod.Post, new { id = "registrationForm" }))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.RegistrationId)

            <!-- TERM -->
            <div class="form-group">
                @Html.DropDownListFor(
                x => x.Term,
                        (IEnumerable<SelectListItem>)ViewBag.Terms,
                        "Select Term",
                        new { @class = "dropdown-midstate", required = "required" }
                        )
        </div>

        <!-- LENGTH -->
        <div class="form-group">
            <label asp-for="LengthOfRequest"></label>

            <select asp-for="LengthOfRequest"
                    class="form-control dropdown-midstate"
                    asp-items="Html.GetEnumSelectList<LengthOfRequest>()">

                <option value="">-- Select Length --</option>

            </select>
        </div>

        <!-- ADD DAY -->
        <div class="form-group">
            <button type="button"
                    class="btn-midstate btn-primary"
                    id="addDayBtn">
                Add Day +
            </button>

            <span class="help-icon"
                  data-help="Add a day and schedule rides for it.">
                ?
            </span>
        </div>

        <!-- DAY CARDS -->
        <div id="dayCardsContainer">

            @if (Model.DaySchedules != null && Model.DaySchedules.Any())
                {
                    for (int d = 0; d < Model.DaySchedules.Count; d++)
                    {
                        var day = Model.DaySchedules[d];

                        <div class="day-card form-paper mb-4 p-4" data-day-index="@d">

                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h4 class="mb-0">Day Request</h4>

                                <button type="button"
                                        class="btn-midstate btn-danger removeDayBtn">
                                    Remove
                                </button>
                            </div>

                            <!-- DAY SELECT -->
                            <div class="form-group mb-3">

                                <select class="dropdown-midstate day-select"
                                        name="DaySchedules[@d].WeekDay"
                                        required>

                                    <option value="">Select Day</option>

                                    @foreach (WeekDay w in Enum.GetValues(typeof(WeekDay)))
                                    {
                                        if (day.WeekDay == w)
                                        {
                                            <option value="@( (int)w )" selected>@w</option>
                                        }
                                        else
                                        {
                                            <option value="@( (int)w )">@w</option>
                                        }
                                    }

                                </select>

                            </div>

                            <!-- ADD RIDE -->
                            <div class="form-group mb-3">
                                <button type="button"
                                        class="btn-midstate btn-secondary addRideBtn">
                                    Add Ride +
                                </button>
                            </div>

                            <div class="ridesContainer mt-2">

                                @if (day.Rides != null)
                                {
                                    for (int r = 0; r < day.Rides.Count; r++)
                                    {
                                        var ride = day.Rides[r];

                                        <div class="ride-row mb-3 p-3 border rounded" data-ride-index="@r">

                                            <input type="hidden"
                                                   name="DaySchedules[@d].Rides[@r].RideId"
                                                   value="@ride.RideId" />

                                            <!-- PICKUP -->
                                            <div class="mb-2">
                                                <select class="dropdown-midstate"
                                                        name="DaySchedules[@d].Rides[@r].PickUpLocationID"
                                                        required>

                                                    <option value="">Pick-Up</option>

                                                    @foreach (var loc in Model.LocationNames)
                                                    {
                                                        <option value="@loc.Value"
                                                                selected="@(loc.Value == ride.PickUpLocationID.ToString())">
                                                            @loc.Text
                                                        </option>
                                                    }

                                                </select>
                                            </div>

                                            <!-- DROPOFF -->
                                            <div class="mb-2">
                                                <select class="dropdown-midstate"
                                                        name="DaySchedules[@d].Rides[@r].DropOffLocationID"
                                                        required>

                                                    <option value="">Drop-Off</option>

                                                    @foreach (var loc in Model.LocationNames)
                                                    {
                                                        <option value="@loc.Value"
                                                                selected="@(loc.Value == ride.DropOffLocationID.ToString())">
                                                            @loc.Text
                                                        </option>
                                                    }

                                                </select>
                                            </div>

                                            <!-- ROUTE -->
                                            <div class="mb-2">
                                                <select class="dropdown-midstate route-select"
                                                        name="DaySchedules[@d].Rides[@r].RouteId">

                                                    <option value="">Select Route (Optional)</option>

                                                    @{
                                                        var routesDict = (Dictionary<(int pickup, int dropoff), List<SelectListItem>>)ViewBag.RoutesByPickDrop;
                                                        var key = (ride.PickUpLocationID, ride.DropOffLocationID);

                                                        if (routesDict != null && routesDict.ContainsKey(key))
                                                        {
                                                            foreach (var route in routesDict[key])
                                                            {
                                                                var isSelected = ride.RouteId != null && ride.RouteId.ToString() == route.Value;

                                                                <option value="@route.Value" selected="@(isSelected ? "selected" : null)">
                                                                    @route.Text
                                                                </option>
                                                            }
                                                        }
                                                    }

                                                </select>
                                            </div>

                                            <!-- TIME -->
                                            <div class="mb-2">
                                                <select class="dropdown-midstate time-select"
                                                        name="DaySchedules[@d].Rides[@r].DropOffTime">

                                                    <option value="">Select Time (Optional)</option>

                                                    @foreach (var time in Model.TimeOptions)
                                                    {
                                                        <option value="@time.Value"
                                                                selected="@(time.Value == ride.DropOffTime.ToString())">
                                                            @time.Text
                                                        </option>
                                                    }

                                                </select>
                                            </div>

                                            <!-- Hot SHortcut To Create Route -->
                                            @if (ride.RouteId == null || ride.RouteId == 0)
                                            {
                                                <div class="mt-2">
                                                <a href="@Url.Action("CreateFromRide", "Routes", new { rideId = ride.RideId })"
                                                   class="btn-midstate btn-warning">
                                                    + Create Route From This Ride Request
                                                </a>
                                                </div>
                                            }
                                            

                                            <!-- REMOVE -->
                                            <div>
                                                <button type="button"
                                                        class="btn-midstate btn-danger removeRideBtn w-100">
                                                    Remove Ride
                                                </button>
                                            </div>

                                        </div>
                                    }
                                }

                            </div>

                        </div>
                    }
                }

            </div>

            <!-- NAME -->
            <div class="form-group">

                <label asp-for="Name"></label>

                <input asp-for="Name"
                       class="form-control midstate-textinput"
                       placeholder="Enter Students Name"
                       required />

            </div>

            <!-- STUDENT ID -->
            <div class="form-group">

                <label>Student ID (Mid-State Students Only)</label>

                <input asp-for="StudentId"
                       class="form-control midstate-textinput"
                       placeholder="8-Digit Student ID" />

            </div>

            <!-- EMAIL -->
            <div class="form-group">

                <label asp-for="Email"></label>

                <input asp-for="Email"
                       class="form-control midstate-textinput"
                       type="email"
                       required />

            </div>

            <!-- PHONE -->
            <div class="form-group">

                <label asp-for="Phone"></label>

                <input asp-for="Phone"
                       class="form-control midstate-textinput"
                       type="tel"
                       required />

            </div>

            <!-- AGE -->
            <div class="form-group">

                <input asp-for="IsAdult" type="checkbox" />
                <label asp-for="IsAdult"></label>

            </div>

            <!-- TERMS -->
            <div class="form-group">

                <input asp-for="AgreeTerms" type="checkbox" />
                <label asp-for="AgreeTerms"></label>

            </div>

            <!-- SAVE -->
            <div class="form-group submit-group">

                <button class="btn-midstate btn-primary"
                        type="submit"
                        @(User.IsInRole("Driver") || User.IsInRole("Rider") ? "disabled" : "")>
                    Save Changes
                </button>

                <a asp-controller="Register"
                   asp-action="ViewAll"
                   class="btn-midstate btn-secondary">
                    Back
                </a>

            </div>

        }

        <!-- ARCHIVE -->
        <form asp-action="ArchiveRegistration" method="post">
            <input type="hidden" name="id" value="@Model.RegistrationId" />
            <button type="submit" class="btn-midstate btn-warning"
                    @(User.IsInRole("Driver") || User.IsInRole("Rider") ? "disabled" : "")>
                Archive
            </button>
        </form>

    </div>
</div>

<!-- Day Card Template -->
<template id="dayCardTemplate">
    <div class="day-card form-paper mb-4 p-4" data-day-index="__dayIndex__">

        <div class="d-flex justify-content-between align-items-center mb-3">
            <h4 class="mb-0">Day Request</h4>

            <button type="button"
                    class="btn-midstate btn-danger removeDayBtn">
                Remove
            </button>
        </div>

        <div class="form-group mb-3">
            <select class="dropdown-midstate day-select"
                    name="DaySchedules[__dayIndex__].WeekDay"
                    required>

                <option value="">Select Day</option>
                <option value="1">Monday</option>
                <option value="2">Tuesday</option>
                <option value="3">Wednesday</option>
                <option value="4">Thursday</option>

            </select>
        </div>

        <div class="form-group mb-3">
            <button type="button"
                    class="btn-midstate btn-secondary addRideBtn">
                Add Ride +
            </button>
        </div>

        <div class="ridesContainer mt-2"></div>

    </div>
</template>

<!-- Ride Template -->
<template id="rideTemplate">

    <div class="ride-row mb-3 p-3 border rounded"
         data-ride-index="__rideIndex__">

        <div class="mb-2">
            <select class="dropdown-midstate"
                    name="DaySchedules[__dayIndex__].Rides[__rideIndex__].PickUpLocationID"
                    required>

                <option value="">Pick-Up</option>

                @foreach (var loc in Model.LocationNames)
                {
                    <option value="@loc.Value">@loc.Text</option>
                }

            </select>
        </div>

        <div class="mb-2">
            <select class="dropdown-midstate"
                    name="DaySchedules[__dayIndex__].Rides[__rideIndex__].DropOffLocationID"
                    required>

                <option value="">Drop-Off</option>

                @foreach (var loc in Model.LocationNames)
                {
                    <option value="@loc.Value">@loc.Text</option>
                }

            </select>
        </div>

        <div class="mb-2">
            <select class="dropdown-midstate route-select"
                    name="DaySchedules[__dayIndex__].Rides[__rideIndex__].RouteId">

                <option value="">Select Route (Optional)</option>

            </select>
        </div>

        <div class="mb-2">
            <select class="dropdown-midstate time-select"
                    name="DaySchedules[__dayIndex__].Rides[__rideIndex__].DropOffTime">

                <option value="">Select Time (Optional)</option>

                @if (Model.TimeOptions != null)
                {
                    foreach (var time in Model.TimeOptions)
                    {
                        <option value="@time.Value">@time.Text</option>
                    }
                }

            </select>
        </div>

        <div>
            <button type="button"
                    class="btn-midstate btn-danger removeRideBtn w-100">
                Remove Ride
            </button>
        </div>

    </div>

</template>

<script>

    // When the form is submitted, run reindexForm()
    // This ensures all dynamically added days and rides have
    // correctly ordered names so ASP.NET can bind them to the model
    document
        .getElementById("registrationForm")
        .addEventListener("submit", reindexForm);


    function reindexForm() {

        // Get every day card currently in the form
        // Each represents one DaySchedule in the model
        const days = document.querySelectorAll(".day-card");

        // Loop through each day and assign a sequential index
        days.forEach((day, dIndex) => {

            // Update the weekday dropdown name
            // ASP.NET expects: DaySchedules[0].WeekDay, DaySchedules[1].WeekDay, etc.
            const daySelect = day.querySelector(".day-select");
            if (daySelect)
                daySelect.name = `DaySchedules[${dIndex}].WeekDay`;

            // Get all rides that belong to this day
            const rides = day.querySelectorAll(".ride-row");

            // Loop through rides and assign sequential ride indexes
            rides.forEach((ride, rIndex) => {

                // Grab each input element in the ride row
                const pickup = ride.querySelector("[name*='PickUpLocationID']");
                const dropoff = ride.querySelector("[name*='DropOffLocationID']");
                const route = ride.querySelector(".route-select");
                const time = ride.querySelector(".time-select");
                const rideId = ride.querySelector("[name*='RideId']");

                // Update the pickup location field name
                // Example result:
                // DaySchedules[0].Rides[0].PickUpLocationID
                if (pickup)
                    pickup.name = `DaySchedules[${dIndex}].Rides[${rIndex}].PickUpLocationID`;

                // Update the dropoff location field name
                if (dropoff)
                    dropoff.name = `DaySchedules[${dIndex}].Rides[${rIndex}].DropOffLocationID`;

                // Update route selection field name
                if (route)
                    route.name = `DaySchedules[${dIndex}].Rides[${rIndex}].RouteId`;

                // Update time selection field name
                if (time)
                    time.name = `DaySchedules[${dIndex}].Rides[${rIndex}].DropOffTime`;

                // If this ride already exists in the database,
                // preserve its RideId so EF can update the correct record
                if (rideId)
                    rideId.name = `DaySchedules[${dIndex}].Rides[${rIndex}].RideId`;

            });

        });

    }

</script>

<script src="/js/RouteSelector.js"></script>
<script src="/js/helpicon.js"></script>
<script src="/js/DayCards.js"></script>