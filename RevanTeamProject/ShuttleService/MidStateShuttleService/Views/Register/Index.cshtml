@using MidStateShuttleService.Enums
@model MidStateShuttleService.Models.RegisterModel

@{
    ViewBag.Title = "Shuttle Service Request";
}

<link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/css/bootstrap.min.css">
<link rel="stylesheet" href="/css/Form.css" />
<link rel="stylesheet" href="/css/Input.css" />
<link rel="stylesheet" href="/css/HelpIcon.css" />

<script src="https://code.jquery.com/jquery-3.3.1.slim.min.js"></script>
<script src="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/js/bootstrap.min.js"></script>

<body>
    <div class="form-container tiled-background-1">
        <div class="form-paper">
           
            <!-- Main Form -->
            <section class="form-section main-form">
                <h2>Thank you for choosing the Shuttle!</h2>
                <h5>Please complete the form below to request transportation from the shuttle.</h5>
                <h5>Don’t see what you are looking for? See information on Special Requests at the bottom of this form.</h5>

                @using (Html.BeginForm("Register", "Register", FormMethod.Post, new { id = "registrationForm" }))
                {
                    @Html.AntiForgeryToken()

                    <!-- TERM -->
                    <div class="form-group">
                        <label asp-for="Term" class="control-label"></label>

                        @Html.DropDownListFor(x => x.Term,
                        (IEnumerable<SelectListItem>)ViewBag.Terms,
                                        "Select Term",
                                        new { @class = "dropdown-midstate", required = "required" })
                    </div>

                    <!-- LENGTH OF REQUEST -->
                    <div class="form-group">
                        <label>Length Of Request</label>

                        <select asp-for="LengthOfRequest"
                                class="form-control  dropdown-midstate"
                                asp-items="Html.GetEnumSelectList<LengthOfRequest>()">
                            <option value="">-- Select Length --</option>
                        </select>
                        <span asp-validation-for="LengthOfRequest" class="text-danger"></span>
                    </div>

                    <!-- ADD DAY BUTTON -->
                    <div class="form-group">
                        
                        <button type="button" class="btn-midstate btn-primary" id="addDayBtn">
                            Add Day +
                        </button>
                        <span class="help-icon" data-help="Add a Day of the week to make rides for.">?</span>
                    </div>

                    <!-- DAY CARDS CONTAINER -->
                    <div id="dayCardsContainer"></div>

                    <!-- FULL NAME -->
                    <div class="form-group">
                        <label asp-for="Name" class="control-label"></label>
                        <input asp-for="Name"
                                class="form-control midstate-textinput"
                                placeholder="Enter your FULL NAME"
                                required />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <!-- STUDENT ID -->
                    <div class="form-group">
                        <label class="control-label">Student ID (Mid-State Students Only)</label>
                        <input asp-for="StudentId"
                               class="form-control midstate-textinput"
                               placeholder="Enter your 8-Digit Student ID" />
                        <span asp-validation-for="StudentId" class="text-danger"></span>
                    </div>

                    <!-- EMAIL -->
                    <div class="form-group">
                        <label asp-for="Email" class="control-label"></label>
                        <input asp-for="Email"
                               class="form-control midstate-textinput"
                               type="email"
                               placeholder="Enter your email"
                               required />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <!-- PHONE -->
                    <div class="form-group">
                        <label asp-for="Phone" class="control-label"></label>
                        <input asp-for="Phone"
                               class="form-control midstate-textinput"
                               type="tel"
                               placeholder="Enter your phone number"
                               required />
                        <span asp-validation-for="Phone" class="text-danger"></span>
                    </div>

                    <!-- Age -->
                    <div class="form-group terms-group">
                        <div class="checkbox-midstate">
                            <input asp-for="IsAdult" type="checkbox" id="IsAdult" name="IsAdult" value="true" />
                            <label for="IsAdult">
                                Are you 18 or older?
                            </label>
                        </div>
                    </div>

                    <!-- TERMS -->
                    <div class="form-group terms-group">
                        <div class="checkbox-midstate">
                            <input asp-for="AgreeTerms" type="checkbox" id="AgreeTerms" name="AgreeTerms" value="true" />
                            <label for="AgreeTerms">
                                I understand my transportation request will be reviewed but is not guaranteed.
                                I will be required to communicate and confirm my request with the shuttle program before it is scheduled.
                            </label>
                        </div>
                    </div>

                    <!-- SUBMIT -->
                    <div class="form-group submit-group">
                        <button class="btn-midstate btn-primary" type="submit">Submit</button>
                        <button class="btn-midstate btn-secondary" type="button" onclick="location.href='/Home/Index'">Cancel</button>
                    </div>
                }
            </section>

            <!-- Special Request -->
            <section class="form-section special-request">
                <h5>Need to Schedule a Special Ride?</h5>
                <p>Please submit a <strong>Special Request</strong> if:</p>
                <ul>
                    <li>Your ride is on a <strong>Friday</strong></li>
                    <li>You only need to ride once</li>
                    <li>You need to ride during Winterim, spring break, or the summer term.</li>
                    <li>You need to go to another location for class.</li>
                    <li>You are a Mid-State Employee</li>
                    <li>All <strong>center</strong> rides are considered a special request. (AMETA, Simulation Center, ect.)</li>
                    <li>You need a ride to/from the dorms.</li>
                </ul>
                <a class="btn-midstate btn-primary"
                   asp-area=""
                   asp-controller="Register"
                   asp-action="SpecialRequest">
                    Submit a Special Request
                </a>
            </section>

        </div>
    </div>

    <!-- Day Card Template -->
    <template id="dayCardTemplate">
        <div class="day-card form-paper mb-4 p-4" data-day-index="__dayIndex__">

            <div class="d-flex justify-content-between align-items-center mb-3">
                <h4 class="mb-0">Day Request</h4>

                <button type="button"
                        class="btn-midstate btn-danger removeDayBtn">
                    Remove
                </button>
            </div>

            <!-- DAY DROPDOWN -->
            <div class="form-group mb-3">
                <select class="dropdown-midstate day-select"
                        name="DaySchedules[__dayIndex__].WeekDay"
                        required>

                    <option value="">Select Day</option>
                    <option value="1">Monday</option>
                    <option value="2">Tuesday</option>
                    <option value="3">Wednesday</option>
                    <option value="4">Thursday</option>

                </select>
            </div>

            <!-- ADD RIDE BUTTON -->
            <div class="form-group mb-3">
                <button type="button"
                        class="btn-midstate btn-secondary addRideBtn">
                    Add Ride +
                </button>
            </div>

            <!-- RIDES CONTAINER -->
            <div class="ridesContainer mt-2"></div>

        </div>
    </template>

    <!-- Ride Template -->
    <template id="rideTemplate">

        <div class="ride-row mb-3 p-3 border rounded"
             data-ride-index="__rideIndex__">

            <!-- PICKUP + DROPOFF -->
            <div class="row mb-2">

                <div class="col-12 col-md-6 mb-2">
                    <select class="dropdown-midstate"
                            name="DaySchedules[__dayIndex__].Rides[__rideIndex__].PickUpLocationID"
                            required>

                        <option value="">Pick-Up</option>

                        @foreach (var loc in Model.LocationNames)
                        {
                            <option value="@loc.Value">@loc.Text</option>
                        }

                    </select>
                </div>

                <div class="col-12 col-md-6 mb-2">
                    <select class="dropdown-midstate"
                            name="DaySchedules[__dayIndex__].Rides[__rideIndex__].DropOffLocationID"
                            required>

                        <option value="">Drop-Off</option>

                        @foreach (var loc in Model.LocationNames)
                        {
                            <option value="@loc.Value">@loc.Text</option>
                        }

                    </select>
                </div>

            </div>

            <!-- ROUTE -->
            <div class="mb-2">

                <select class="dropdown-midstate route-select"
                        name="DaySchedules[__dayIndex__].Rides[__rideIndex__].RouteId">

                    <option value="">Select Route (Optional)</option>

                </select>

            </div>

            <!-- TIME -->
            <div class="mb-2">

                <select class="dropdown-midstate time-select"
                        name="DaySchedules[__dayIndex__].Rides[__rideIndex__].DropOffTime">

                    <option value="">Select Time (Optional)</option>

                    @if (Model.TimeOptions != null)
                    {
                        foreach (var time in Model.TimeOptions)
                        {
                            <option value="@time.Value">@time.Text</option>
                        }
                    }

                </select>

            </div>

            <!-- REMOVE BUTTON -->
            <div>
                <button type="button"
                        class="btn-midstate btn-danger removeRideBtn w-100">

                    Remove Ride

                </button>
            </div>

        </div>

    </template>

    <style>
        @@media (max-width: 768px) {
            .ride-row

        {
            border-bottom: 1px solid #eee;
            padding-bottom: 12px;
            margin-bottom: 12px;
        }

        }
    </style>



<script src="/js/RouteSelector.js"></script>
<script src="/js/helpicon.js"></script>
<script src="/js/DayCards.js"></script>

</body>

