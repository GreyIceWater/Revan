@using MidStateShuttleService.Enums
@model MidStateShuttleService.Models.RegisterModel

@{
    ViewBag.Title = "Shuttle Service Special Request";
}

<link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/css/bootstrap.min.css">
<link rel="stylesheet" href="/css/Form.css" />
<link rel="stylesheet" href="/css/Input.css" />
<link rel="stylesheet" href="/css/HelpIcon.css" />

<script src="https://code.jquery.com/jquery-3.3.1.slim.min.js"></script>
<script src="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/js/bootstrap.min.js"></script>

<body>
<div class="form-container">
    <div class="form-paper">

            <!-- Special Request -->
            <section class="form-section special-request">
                <p><strong>Please note: Personal home addresses or private residences cannot be used as pick-up or drop-off locations</strong><br /><br /></p>
                <p><strong>Need to go back to the Non-Special Request Form?</strong></p>
                <a class="btn-midstate btn-primary"
                   asp-area=""
                   asp-controller="Register"
                   asp-action="Index">
                   Click Here to Go Back 
                </a>
            </section>

        <h2 class="title">Request a Special Request</h2>

        @using (Html.BeginForm("Register", "Register", FormMethod.Post, new { id = "registrationForm" }))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.isCustom)

            <input type="hidden" id="DeviceIpAddress" name="DeviceIpAddress" />

            <!-- TERM -->
            <div class="form-group">
                @Html.LabelFor(m => m.Term, "School Term")
                @Html.DropDownListFor(m => m.Term,
                                     (IEnumerable<SelectListItem>)ViewBag.Terms,
                                     "Select Term",
                                     new { @class = "dropdown-midstate", required = "required" })
            </div>

            <!-- DATE -->
            <div class="form-group">
                @Html.LabelFor(m => m.customDate, "Date needing Ride")
                <span class="help-icon" data-help="Select the date needed for a ride, 
                if you need a repeating ride (example: every Monday) select the starting date.">?</span>
                @Html.TextBoxFor(m => m.customDate,
                                 "{0:yyyy-MM-dd}",
                                 new { @class = "midstate-date", type = "date" })
            </div>

            <!-- TIMES -->
            <div class="row row-space">
                <div class="col-6">
                    <div class="form-group">
                        @Html.LabelFor(m => m.customTime1, "First Ride Time")
                        <span class="help-icon" data-help="Enter the pickup time for your first ride.">?</span>
                        @Html.TextBoxFor(m => m.customTime1,
                                     "{0:HH\\:mm}",
                                     new { @class = "midstate-textinput", type = "time" })
                    </div>
                </div>

                <div class="col-6">
                    <div class="form-group">
                        @Html.LabelFor(m => m.customTime2, "Return Ride Time")
                        <span class="help-icon" data-help="Required only if Round Trip is selected.">?</span>
                        @Html.TextBoxFor(m => m.customTime2,
                                     "{0:HH\\:mm}",
                                     new { @class = "midstate-textinput", type = "time" })
                    </div>
                </div>
            </div>

            <!-- NOTES -->
            <div class="form-group">
                @Html.LabelFor(m => m.customMessage, "Special Request Ride Details")
                <span class="help-icon" data-help="Please fill out details about your request here.">?</span>
                @Html.TextAreaFor(m => m.customMessage,
                                 5, 50,
                                 new { @class = "midstate-textinput", placeholder = "Enter additional details..." })
            </div>

            <!-- FULL NAME -->
            <div class="form-group">
                <label asp-for="Name" class="control-label"></label>
                <input asp-for="Name"
                       class="form-control midstate-textinput"
                       placeholder="Enter your FULL NAME"
                       required />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <!-- STUDENT ID -->
            <div class="form-group">
                <label class="control-label">Student ID (Mid-State Students Only)</label>
                <input asp-for="StudentId"
                       class="form-control midstate-textinput"
                       placeholder="Enter your 8-Digit Student ID" />
                <span asp-validation-for="StudentId" class="text-danger"></span>
            </div>

            <!-- EMAIL -->
            <div class="form-group">
                <label asp-for="Email" class="control-label"></label>
                <input asp-for="Email"
                        class="form-control midstate-textinput"
                        type="email"
                        placeholder="Enter your email"
                        required />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <!-- PHONE -->
            <div class="form-group">
                <label asp-for="Phone" class="control-label"></label>
                <input asp-for="Phone"
                        class="form-control midstate-textinput"
                        type="tel"
                        placeholder="Enter your phone number"
                        required />
                <span asp-validation-for="Phone" class="text-danger"></span>
            </div>

            <!-- Age -->
            <div class="form-group terms-group">
                <div class="checkbox-midstate">
                    <input asp-for="IsAdult" type="checkbox" id="IsAdult" name="IsAdult" value="true" />
                    <label for="IsAdult">
                        Are you older than the age of 18?
                    </label>
                </div>
            </div>

            <!-- TERMS -->
            <div class="form-group terms-group">
                <div class="checkbox-midstate">
                    <input asp-for="AgreeTerms" type="checkbox" id="AgreeTerms" name="AgreeTerms" value="true" />
                    <label for="AgreeTerms">
                        I understand my transportation request will be reviewed but is not guaranteed.
                    </label>
                </div>
            </div>

            <!-- SUBMIT -->
            <div class="form-group submit-group">
                <button class="btn-midstate btn-primary" type="submit">Submit</button>
                <button class="btn-midstate btn-secondary" type="button" onclick="location.href='/Home/Index'">Cancel</button>
            </div>
        }
    </div>
</div>
</div>

<script src="/js/helpicon.js"></script>
</body>