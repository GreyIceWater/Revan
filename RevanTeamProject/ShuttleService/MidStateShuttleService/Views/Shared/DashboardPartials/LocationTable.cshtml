@{
}
@model MidStateShuttleService.Models.AllModels

<div class="cardHeader">
    <h2>Locations</h2>

    <!--search-->
    <!--<div class="search">
        <label>
            <input id="locationSearch" type="text" placeholder="Search" />
            <i class="bi bi-search"></i>
        </label>
    </div>-->
    @if (User.IsInRole("Admin"))
    {
        <a asp-controller="Location" asp-action="Create" class="btn">Add Location</a>
    }
</div>

<table>
    <thead>
        <tr>
            <td>Stop Name</td>
            <td>Address</td>
            <td>City</td>
            <td>State</td>
            <td>Zip Code</td>
            <td>Abbreviation</td>
            <td>Status</td>
            <td>Actions</td>
        </tr>
    </thead>

    <tbody id="locationsTableBody">
        @if (Model == null || Model.Location == null || !Model.Location.Any(location => location.IsActive))
        {
            <tr>
                <td colspan="8" class="text-center">There are Currently No Locations</td>
            </tr>
        }
        else
        {
            @foreach (var location in Model.Location.Where(location => location.IsActive).OrderBy(location => location.Name))
            {
                <tr class="locationRow">
                    <td>@location.Name</td>
                    <td>@location.Address</td>
                    <td>@location.City</td>
                    <td>@location.State</td>
                    <td>@location.ZipCode</td>
                    <td>@location.Abbreviation</td>
                    <td>Active</td>

                    <td>
                        @if (User.IsInRole("Admin"))
                        {
                            <a asp-controller="Location"
                               asp-action="Edit"
                               asp-route-id="@location.LocationId">Update</a>

                            <span> | </span>

                            <form asp-controller="Location"
                                  asp-action="DeleteLocation"
                                  asp-route-id="@location.LocationId"
                                  method="post"
                                  style="display:inline;">

                                @Html.AntiForgeryToken()

                                <button type="submit"
                                        style="background:none;border:none;padding:0;color:#0d6efd;text-decoration:underline;cursor:pointer;">
                                    Remove
                                </button>

                            </form>
                        }
                    </td>
                </tr>
            }
        }
    </tbody>
</table>

<div id="pagination-controls-location" class="pagination">
    <!-- Pagination buttons will be created by JavaScript here -->
</div>

<script src="~/js/tablePagination.js"></script>