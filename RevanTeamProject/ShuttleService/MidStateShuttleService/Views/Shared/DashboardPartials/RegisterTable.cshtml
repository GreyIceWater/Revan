@model MidStateShuttleService.Models.AllModels

<div class="cardHeader">
    <h2>Requests</h2>
    <!--search
        <div class="search">
        <label>
            <input id="registrationSearch" type="text" placeholder="Search" />
            <i class="bi bi-search"></i>
        </label>
    </div>
    -->

</div>
<table>
    <thead>
        <tr>
            <td>Name</td>
            <td>Date</td>
            <td>Pick Up Route</td>
            <td>Pick Up / Drop Off</td>
            <td>Return Route</td>
            <td>Return Pick Up / Drop Off</td>
            <td>Info</td>
            <td>Type</td>
            <td>Status</td>
            <td></td>
        </tr>
    </thead>
    <tbody id="registrationsTableBody">

        @if (Model.Register == null)
        {
            // Changing registrions to requests
            <tr><td colspan="4" class="text-center">There are Currently No Requests</td></tr>
        }
        else
        {
            var routeDict = Model.Route.ToDictionary(r => r.RouteID);

            @foreach (var registration in Model.Register.OrderByDescending(r => r.FirstDayExpectingToRide))
            {
                int routeId = 0;
                int returnRouteId = 0;
                int.TryParse(registration.SelectedRouteDetail, out routeId);
                int.TryParse(registration.ReturnSelectedRouteDetail, out returnRouteId);

                routeDict.TryGetValue(routeId, out var route);
                routeDict.TryGetValue(returnRouteId, out var returnRoute);

                var pickUp = route?.PickUpTime?.ToString(@"hh\:mm") ?? "";
                var dropOff = route?.DropOffTime?.ToString(@"hh\:mm") ?? "";
                var returnPickUp = returnRoute?.PickUpTime?.ToString(@"hh\:mm") ?? "";
                var returnDropOff = returnRoute?.DropOffTime?.ToString(@"hh\:mm") ?? "";

                if (route?.PickUpTime != null)
                    pickUp = DateTime.Today.Add(route.PickUpTime.Value).ToString("h:mm tt");
                if (route?.DropOffTime != null)
                    dropOff = DateTime.Today.Add(route.DropOffTime.Value).ToString("h:mm tt");
                if (returnRoute?.PickUpTime != null)
                    returnPickUp = DateTime.Today.Add(returnRoute.PickUpTime.Value).ToString("h:mm tt");
                if (returnRoute?.DropOffTime != null)
                    returnDropOff = DateTime.Today.Add(returnRoute.DropOffTime.Value).ToString("h:mm tt");

                <tr class="registrationRow">
                    <td>@(registration.FirstName) @(registration.LastName)</td>
                    <td>@registration.FirstDayExpectingToRide</td>
                    <td>@($"{route?.PickUpLocation?.Name ?? "Unknown"} → {route?.DropOffLocation?.Name ?? "Unknown"}")</td>
                    <td>@($"{pickUp} / {dropOff}")</td>
                    <td>
                        @(returnRoute != null
                            ? $"{returnRoute.PickUpLocation?.Name} → {returnRoute.DropOffLocation?.Name}"
                            : "")
                    </td>
                    <td>@(returnRoute != null ? $"{returnPickUp} / {returnDropOff}" : "")</td>
                    <td>
                        @if (registration.NeedTransportation != null && registration.NeedTransportation.Length > 10)
                        {
                            @registration.NeedTransportation.Substring(0, 10)
                            <span class="ellipsis">...</span>
                        }
                        else
                        {
                            @registration.NeedTransportation
                        }
                    </td>
                    <td></td>
                    <td>@(registration.RequestStatus)</td>
                    <td>
                        <a class="viewButton" href="#"
                            data-toggle="modal"
                            data-target="#specialRequestDetailsModal"
                            data-message-id="@registration.RegistrationId"
                            data-full-message="@registration.NeedTransportation">View</a>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>
<div class="modal fade" id="specialRequestDetailsModal" tabindex="-1" role="dialog" aria-labelledby="specialRequestDetailsModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="specialRequestDetailsModalLabel">Special Request Details</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div id="specialRequestDetailsContent">
                    <!-- Special request details will be displayed here -->
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
<tr>
    <div id="pagination-controls-registration" class="pagination">
        <!-- Pagination buttons will be created by JavaScript here -->
    </div>
</tr>

<script src="~/js/tablePagination.js"></script>


<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<script src="~/js/RequestModal.js"></script>