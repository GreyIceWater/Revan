@* Views/Shared/DashboardPartials/ReportsTable.cshtml *@
@* DEV NOTE: Dashboard widget for running admin reports *@

<div class="cardHeader">
    <h2>Reports</h2>
</div>

<div class="detailsBody">

    <p class="mutedText">
        Run administrative reports and export CSV files.
    </p>

    <div class="tableWrap">

        <table class="reportsTable">

            <thead style="background:#840029; color:#EEEEEE;">
                <tr>
                    <th>Report Type</th>
                    <th>Date Range</th>
                    <th style="text-align:right;">Actions</th>
                </tr>
            </thead>

            <tbody>

                <!-- Rider Requests -->
                <tr>

                    <td>
                        <strong>Rider Requests</strong>
                        <div class="tableSubText">
                            All rider registration records
                        </div>
                    </td>

                    <td>
                        All time
                    </td>

                    <td style="text-align:right; white-space:nowrap;">

                        <a class="btn btn-sm reportActionLink"
                           href="@Url.Action("Reports", "Dashboard", new { report = "requests" })">
                            Run
                        </a>

                        <a class="btn btn-sm reportActionLink"
                           style="margin-left:6px;"
                           href="@Url.Action("ExportRiderRequestsCsv", "Dashboard")">
                            Export CSV
                        </a>

                    </td>

                </tr>


                <!-- Check-ins -->
                <tr>

                    <td>
                        <strong>Check-ins</strong>
                        <div class="tableSubText">
                            Rider check-in activity logs
                        </div>
                    </td>

                    <td>
                        All time
                    </td>

                    <td style="text-align:right; white-space:nowrap;">

                        <a class="btn btn-sm reportActionLink"
                           href="@Url.Action("Reports", "Dashboard", new { report = "checkins" })">
                            Run
                        </a>

                        <a class="btn btn-sm reportActionLink"
                           style="margin-left:6px;"
                           href="@Url.Action("ExportCheckInsCsv", "Dashboard")">
                            Export CSV
                        </a>

                    </td>

                </tr>

            </tbody>

        </table>

    </div>

</div>