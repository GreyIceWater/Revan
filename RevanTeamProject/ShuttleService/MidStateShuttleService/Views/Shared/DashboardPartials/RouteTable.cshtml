@{
}
@model MidStateShuttleService.Models.AllModels

<div class="cardHeader">
    <h2>Routes</h2>
    <!--search
        <div class="search">
        <label>
            <input id="routeSearch" type="text" placeholder="Search" />
            <i class="bi bi-search"></i>
        </label>
    </div>
    -->
    @if (User.IsInRole("Admin"))
    {
        <a asp-controller="Routes" asp-action="Create" class="btn">Add Route</a>
    }
</div>

<table>
    <thead>
        <tr>
            <td>Reservation List</td>
            <td>Pick Up Location</td>
            <td>Drop Off Location</td>
            <td>Pick Up Time</td>
            <td>Drop Off Time</td>
            <td>Driver</td>
            <td>Additional Details</td>
            <td>Status</td>
            <td>Actions</td>
        </tr>
    </thead>
    <tbody id="routesTableBody">
        @if (Model.Route == null || !Model.Route.Any())
        {
            <tr>
                <td colspan="9" class="text-center">There are Currently No Routes</td>
            </tr>
        }
        else
        {
            @foreach (var route in Model.Route
                    .Where(route => route.IsActive)
                    .OrderBy(route => route.PickUpLocationID)
                    .ThenBy(route => route.PickUpTime))
            {
                <tr class="routeRow">
                    <td>
                        <a asp-controller="Dashboard" asp-action="PassengerList" asp-route-id="@route.RouteID">View Reservations</a>
                    </td>
                    <td>@route.PickUpLocation.ToStringPickup()</td>
                    <td>@route.DropOffLocation.ToStringDropoff()</td>
                    <td>@route.ToStringPickUpTime()</td>
                    <td>@route.ToStringDropOffTime()</td>
                    <td>@route.Driver.ToStringDriver()</td>
                    <td>@route.AdditionalDetails</td>
                    <td>
                        @if (route.IsActive)
                        {
                            <span>Active</span>
                        }
                        else
                        {
                            <span>Inactive</span>
                        }
                    </td>

                    <td>
                        @if (User.IsInRole("Admin"))
                        {
                            <a asp-controller="Routes" asp-action="Edit" asp-route-id="@route.RouteID">Update</a>

                            <form asp-controller="Routes"
                                  asp-action="Delete"
                                  asp-route-id="@route.RouteID"
                                  method="post"
                                  style="display:inline;">
                                @Html.AntiForgeryToken()
                                <button type="submit"
                                        style="background:none; border:none; padding:0; color:inherit; text-decoration:underline; cursor:pointer;">
                                    Remove
                                </button>
                            </form>
                        }
                    </td>
                </tr>
            }
        }
    </tbody>
</table>

<div id="pagination-controls-routes" class="pagination">
    <!-- Pagination buttons will be created by JavaScript here -->
</div>

<script src="~/js/tablePagination.js"></script>