@{
}
@model MidStateShuttleService.Models.AllModels

<div class="cardHeader">
    <h2>Shuttles</h2>
    <!--search
        <div class="search">
        <label>
            <input id="shuttleSearch" type="text" placeholder="Search" />
            <i class="bi bi-search"></i>
        </label>
    </div>
    -->
    @if (User.IsInRole("Admin"))
    {
        <a asp-controller="Shuttles" asp-action="Create" class="btn">Add Shuttle</a>
    }

</div>
<table>
    <thead>
        <tr>
            <td>Shuttle Number</td>
            <td>Passenger Capacity</td>
            <td>Status</td>
            <td>Actions</td>
        </tr>
    </thead>
    <tbody id="shuttleTableBody">
        @if (Model == null || Model.Bus == null || !Model.Bus.Any())
        {
            <tr><td colspan="4" class="text-center">There are Currently No Shuttles</td></tr>
        }
        else
        {
            @foreach (var shuttle in Model.Bus.Where(shuttle => shuttle.IsActive == true).OrderBy(shuttle => shuttle.BusNo))
            {
                <tr class="shuttleRow">
                    <td>@shuttle.BusNo</td>
                    <td>@shuttle.PassengerCapacity</td>
                    <td>@(shuttle.IsActive == true ? "Active" : "Inactive")</td>
                    <td>
                        @if (User.IsInRole("Admin"))
                        {
                            <a asp-controller="Shuttles" asp-action="Edit" asp-route-id="@shuttle.BusId">Update</a>
                            <span> | </span>
                            <a asp-controller="Shuttles" asp-action="Delete" asp-route-id="@shuttle.BusId">Remove</a>
                        }
                    </td>
                </tr>
            }
        }
    </tbody>
</table>
<div id="pagination-controls-shuttle" class="pagination">
    <!-- Pagination buttons will be created by JavaScript here -->
</div>

<script src="~/js/tablePagination.js"></script>