@model IEnumerable<MidStateShuttleService.Models.Bus>

@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}


@await Html.PartialAsync("~/Views/Shared/_DashboardNav.cshtml")

<!-- If true use the inverted version to show a difference -->
@if ((bool?)ViewData["Archives"] == true)
{
    <style>
        .tiled-background-2 {
            background-image: url('/img/tiled_background_variant_3.png');
        }
    </style>
}

<div class="form-container tiled-background-2">
    <div class="form-paper">

        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h2>Shuttles</h2>
                <p class="mb-0">Manage shuttle fleet.</p>
            </div>

            @if (User.IsInRole("Admin"))
            {
                <a asp-controller="Shuttles" asp-action="Create" class="btn btn-midstate">
                    <i class="bi bi-plus-circle-fill me-1"></i> Add Shuttle
                </a>
            }
        </div>

        <div id="shuttleTableBody">

            @if (Model == null || !Model.Any())
            {
                <div class="form-paper p-3">
                    <p>There are currently no shuttles.</p>
                </div>
            }
            else
            {
                @foreach (var shuttle in Model.OrderBy(shuttle => shuttle.BusNo))
                {
                    <div class="form-paper mb-4 p-4 position-relative shuttle-card">

                        <div class="d-flex justify-content-between align-items-start">

                            <div>
                                <h4 class="mb-1">Shuttle #@shuttle.BusNo</h4>

                                <div class="mb-1">
                                    <strong>Passenger Capacity:</strong> @shuttle.PassengerCapacity
                                </div>
                            </div>

                            <div class="text-end">
                                @if (User.IsInRole("Admin"))
                                {
                                    <a asp-controller="Shuttles"
                                       asp-action="Edit"
                                       asp-route-id="@shuttle.BusId"
                                       class="btn btn-midstate btn-sm me-1">
                                        <i class="bi bi-pencil-fill me-1"></i> Update
                                    </a>

                                    if ((bool?)ViewData["Archives"] == true)
                                    {
                                        <form asp-action="Unarchive" method="post">
                                            <input type="hidden" name="id" value="@shuttle.BusId" />
                                            <button class="btn btn-midstate btn-danger btn-sm" type="submit">Unarchive</button>
                                        </form>
                                    }
                                    else
                                    {
                                       <a asp-controller="Shuttles"
                                           asp-action="Delete"
                                           asp-route-id="@shuttle.BusId"
                                           class="btn btn-midstate btn-danger btn-sm">
                                            <i class="bi bi-trash-fill me-1"></i> Archive
                                        </a> 
                                    }
                                }
                            </div>

                        </div>

                    </div>
                }
            }

        </div>

        <div id="pagination-controls-shuttle" class="pagination"></div>

    </div>
</div>

<script src="~/js/tablePagination.js"></script>
<script src="/js/Dashboard/Table.js"></script>
<script src="/js/SearchFunc/RouteSearch.js"></script>