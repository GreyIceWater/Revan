@model MidStateShuttleService.Models.User

@{
    ViewBag.Title = "Account Details";
}

<link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/css/bootstrap.min.css">
<link rel="stylesheet" href="/css/Form.css" />
<link rel="stylesheet" href="/css/Input.css" />
<link rel="stylesheet" href="/css/HelpIcon.css" />


<script src="https://code.jquery.com/jquery-3.3.1.slim.min.js"></script>
<script src="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/js/bootstrap.min.js"></script>

<body>
    <div class="form-container tiled-background-2">
        <div class="form-paper">

            <section class="form-section">
                <h2>Account Details</h2>

                <!-- Name -->
                <div class="form-group">
                    <label>Full Name</label>
                    <div class="midstate-textinput" style="background-color:#f8f8f8;">
                        @Model.FirstName @Model.LastName
                    </div>
                </div>

                <!-- Phone -->
                <div class="form-group">
                    <label>Phone Number</label>
                    <div class="midstate-textinput" style="background-color:#f8f8f8;">
                        @Model.PhoneNumber
                    </div>
                </div>

                <!-- Student ID -->
                <div class="form-group">
                    <label>Student ID</label>
                    <div class="midstate-textinput" style="background-color:#f8f8f8;">
                        @Model.StudentId
                    </div>
                </div>

                <!-- Email -->
                <div class="form-group">
                    <label>Email (Microsoft Account)</label>
                    @{
                        var email = User.FindFirst("email")?.Value
                        ?? User.FindFirst("preferred_username")?.Value
                        ?? User.Identity?.Name
                        ?? "N/A";
                    }
                    <div class="midstate-textinput" style="background-color:#f8f8f8;">
                        @email
                    </div>
                </div>

                <!-- Button -->
                <div class="form-group submit-group">
                    <a class="btn-midstate btn-primary"
                       asp-action="AccountSetup">
                        Edit Account
                    </a>

                    <a class="btn-midstate btn-secondary"
                       href="/">
                        Back
                    </a>
                </div>

            </section>

        </div>
    </div>
</body>